# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Never commit .env.local.

# Public (sent to the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key

# Server only (bypasses RLS). Used for creating worker accounts. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx                          # or the legacy "service_role" key

# Usernames are mapped to synthetic emails: <username>@<LOGIN_EMAIL_DOMAIN>. No email is ever sent.
# Must stay the same once users exist.
LOGIN_EMAIL_DOMAIN=staff.cafescm.app
